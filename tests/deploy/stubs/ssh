#!/usr/bin/env bash
# Fake ssh: log the call, then run the remote command locally.
S="$STUB_STATE"
# Like real ssh: without -n it reads (and forwards) stdin, so a call inside a
# `while read` loop swallows the rest of the loop's input.
no_stdin=0
while [[ "${1:-}" == -o || "${1:-}" == -n ]]; do
  if [[ "$1" == -n ]]; then no_stdin=1; shift; else shift 2; fi
done
[[ $no_stdin == 1 || -t 0 ]] || cat >/dev/null
host="$1"; shift
printf 'ssh %s %s\n' "$host" "$*" >>"$S/calls"
[[ -e "$S/ssh_down" ]] && { echo "ssh: connect to host $host: timed out" >&2; exit 255; }
exec bash -c "$*"
